{
  "shell": {
    "architect": "claude --model claude-opus-4-8",
    "builder": "claude --model claude-opus-4-8"
  },
  "agentFarm": {
    "requireAuth": false,
    "requireAuthLocalhost": false,
    "allowedHosts": [
      "cloud2.lavandulagroup.com"
    ]
  },
  "server": {
    "bind": "127.0.0.1"
  },
  "permissions": {
    "bypass": true
  },
  "consult": {
    "gemini": {
      "auth": "apikey",
      "model": "gemini-3-pro-preview"
    },
    "claude": {
      "auth": "subscription",
      "model": "claude-opus-4-8"
    }
  }
}
